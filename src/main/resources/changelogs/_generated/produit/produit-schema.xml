<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

   <changeSet id="1" author="Produit-schema-sequence">
        <validCheckSum>ANY</validCheckSum>
        <preConditions>
             <not>
                 <sequenceExists sequenceName="produit_oid_seq"/>
             </not>
          </preConditions>
          <createSequence sequenceName="produit_oid_seq" incrementBy="3" startValue="11123"/>
    </changeSet>

	<changeSet id="1" author="Produit-schema">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="produit">
            <column name="OID" type="integer" defaultValueComputed="nextval('produit_oid_seq')">
                <constraints primaryKey="true" unique="true"/>
            </column>

            <column name="CREATE_DATE" type="TIMESTAMP"  defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="CREATED_BY" type="varchar(255)" defaultValue="system">
                <constraints nullable="false" />
            </column>
            <column name="LAST_MODIFIED_BY" type="varchar(255)" defaultValue="system">
                <constraints nullable="false" />
            </column>
            <column name="MODIFIED_DATE" type="TIMESTAMP"  defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="VERSION" type="BIGINT" defaultValue="1">
                <constraints nullable="false" />
            </column>
            <column name="container_oid" type="BIGINT" defaultValue="1">
                <constraints nullable="false" />
            </column>

                    <column name="prix" type="NUMERIC"/>
        <column name="actif" type="INTEGER"/>
        <column name="mise_en_avant" type="INTEGER"/>
        <column name="unite" type="VARCHAR(255)"/>
        <column name="description" type="TEXT"/>
        <column name="nom" type="VARCHAR(255)"/>
<!--COLUMNS-->
        </createTable>
    </changeSet>

    <changeSet id="drop-index" author="Produit-schema-master">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <indexExists
                indexName="produit_primary_index"
                tableName="produit"/>
        </preConditions>

        <dropIndex indexName="produit_primary_index" tableName="produit"/>
    </changeSet>

    <changeSet id="create-optimized-indexes-produit" author="system">
        <validCheckSum>ANY</validCheckSum>
        <createIndex indexName="produit_idx_version" tableName="produit">
            <column name="version"/>
        </createIndex>
        <createIndex indexName="produit_idx_create" tableName="produit">
            <column name="create_date"/>
        </createIndex>
        <createIndex indexName="produit_idx_modified" tableName="produit">
            <column name="modified_date"/>
        </createIndex>

         <!-- Index version + create_date -->
         <createIndex indexName="produit_idx_version_create" tableName="produit">
             <column name="version"/>
             <column name="create_date"/>
         </createIndex>

         <!-- Index modified_date + last_modified_by -->
         <createIndex indexName="produit_idx_modified_idx_last_modified" tableName="produit">
             <column name="modified_date"/>
             <column name="last_modified_by"/>
         </createIndex>

         <!-- Index created_by -->
         <createIndex indexName="produit_idx_created_by" tableName="produit">
             <column name="created_by"/>
         </createIndex>

         <createIndex indexName="produit_idx_nom" tableName="produit">
	<column name="nom"/>
</createIndex>
<createIndex indexName="produit_idx_unite" tableName="produit">
	<column name="unite"/>
</createIndex>
<createIndex indexName="produit_idx_mise_en_avant" tableName="produit">
	<column name="mise_en_avant"/>
</createIndex>
<createIndex indexName="produit_idx_actif" tableName="produit">
	<column name="actif"/>
</createIndex>
<createIndex indexName="produit_idx_prix" tableName="produit">
	<column name="prix"/>
</createIndex>
<!--COLUMNS_INDEX-->
     </changeSet>

     <changeSet id="add-col-uid-on-produit" author="system">
        <validCheckSum>ANY</validCheckSum>
         <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="produit" columnName="UID"/>
            </not>
        </preConditions>
        <addColumn tableName="produit">
            <column name="UID" type="VARCHAR(36)"/>
        </addColumn>
     </changeSet>

    <changeSet id="add-col-nom-on-produit" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="produit" columnName="nom"/></not>
        </preConditions>
        <addColumn tableName="produit">
                    <column name="nom" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-idx-nom-on-produit" author="system" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="produit" columnName="nom"/>
        </preConditions>
        <sql dbms="postgresql">CREATE INDEX IF NOT EXISTS produit_idx_nom ON produit ("nom")</sql>
        <sql dbms="h2">CREATE INDEX IF NOT EXISTS produit_idx_nom ON produit (nom)</sql>
    </changeSet>
    <changeSet id="add-col-description-on-produit" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="produit" columnName="description"/></not>
        </preConditions>
        <addColumn tableName="produit">
                    <column name="description" type="TEXT"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-col-unite-on-produit" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="produit" columnName="unite"/></not>
        </preConditions>
        <addColumn tableName="produit">
                    <column name="unite" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-idx-unite-on-produit" author="system" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="produit" columnName="unite"/>
        </preConditions>
        <sql dbms="postgresql">CREATE INDEX IF NOT EXISTS produit_idx_unite ON produit ("unite")</sql>
        <sql dbms="h2">CREATE INDEX IF NOT EXISTS produit_idx_unite ON produit (unite)</sql>
    </changeSet>
    <changeSet id="add-col-mise_en_avant-on-produit" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="produit" columnName="mise_en_avant"/></not>
        </preConditions>
        <addColumn tableName="produit">
                    <column name="mise_en_avant" type="INTEGER"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-idx-mise_en_avant-on-produit" author="system" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="produit" columnName="mise_en_avant"/>
        </preConditions>
        <sql dbms="postgresql">CREATE INDEX IF NOT EXISTS produit_idx_mise_en_avant ON produit ("mise_en_avant")</sql>
        <sql dbms="h2">CREATE INDEX IF NOT EXISTS produit_idx_mise_en_avant ON produit (mise_en_avant)</sql>
    </changeSet>
    <changeSet id="add-col-actif-on-produit" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="produit" columnName="actif"/></not>
        </preConditions>
        <addColumn tableName="produit">
                    <column name="actif" type="INTEGER"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-idx-actif-on-produit" author="system" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="produit" columnName="actif"/>
        </preConditions>
        <sql dbms="postgresql">CREATE INDEX IF NOT EXISTS produit_idx_actif ON produit ("actif")</sql>
        <sql dbms="h2">CREATE INDEX IF NOT EXISTS produit_idx_actif ON produit (actif)</sql>
    </changeSet>
    <changeSet id="add-col-prix-on-produit" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="produit" columnName="prix"/></not>
        </preConditions>
        <addColumn tableName="produit">
                    <column name="prix" type="NUMERIC"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-idx-prix-on-produit" author="system" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="produit" columnName="prix"/>
        </preConditions>
        <sql dbms="postgresql">CREATE INDEX IF NOT EXISTS produit_idx_prix ON produit ("prix")</sql>
        <sql dbms="h2">CREATE INDEX IF NOT EXISTS produit_idx_prix ON produit (prix)</sql>
    </changeSet>

    <changeSet id="6" author="Produit-schema-thumbed">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="produit">
            <column name="thumbnail_oid" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint  baseColumnNames="thumbnail_oid"
                                  baseTableName="produit"
                                  constraintName="Produit_thumbed_thumbnail_fk_oid_constraint"
                                  referencedColumnNames="oid"
                                  referencedTableName="T_THUMBNAIL_HOLDER"/>
    </changeSet>
</databaseChangeLog>

