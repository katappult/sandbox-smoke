<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

   <changeSet id="1" author="Annonce-schema-sequence">
        <validCheckSum>ANY</validCheckSum>
        <preConditions>
             <not>
                 <sequenceExists sequenceName="annonce_oid_seq"/>
             </not>
          </preConditions>
          <createSequence sequenceName="annonce_oid_seq" incrementBy="3" startValue="11123"/>
    </changeSet>

	<changeSet id="1" author="Annonce-schema">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="annonce">
            <column name="OID" type="integer" defaultValueComputed="nextval('annonce_oid_seq')">
                <constraints primaryKey="true" unique="true"/>
            </column>

            <column name="CREATE_DATE" type="TIMESTAMP"  defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="CREATED_BY" type="varchar(255)" defaultValue="system">
                <constraints nullable="false" />
            </column>
            <column name="LAST_MODIFIED_BY" type="varchar(255)" defaultValue="system">
                <constraints nullable="false" />
            </column>
            <column name="MODIFIED_DATE" type="TIMESTAMP"  defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="VERSION" type="BIGINT" defaultValue="1">
                <constraints nullable="false" />
            </column>
            <column name="container_oid" type="BIGINT" defaultValue="1">
                <constraints nullable="false" />
            </column>

                    <column name="prix" type="NUMERIC"/>
        <column name="actif" type="INTEGER"/>
        <column name="description" type="TEXT"/>
        <column name="titre" type="VARCHAR(255)"/>
<!--COLUMNS-->
        </createTable>
    </changeSet>

    <changeSet id="drop-index" author="Annonce-schema-master">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <indexExists
                indexName="annonce_primary_index"
                tableName="annonce"/>
        </preConditions>

        <dropIndex indexName="annonce_primary_index" tableName="annonce"/>
    </changeSet>

    <changeSet id="create-optimized-indexes-annonce" author="system">
        <validCheckSum>ANY</validCheckSum>
        <createIndex indexName="annonce_idx_version" tableName="annonce">
            <column name="version"/>
        </createIndex>
        <createIndex indexName="annonce_idx_create" tableName="annonce">
            <column name="create_date"/>
        </createIndex>
        <createIndex indexName="annonce_idx_modified" tableName="annonce">
            <column name="modified_date"/>
        </createIndex>

         <!-- Index version + create_date -->
         <createIndex indexName="annonce_idx_version_create" tableName="annonce">
             <column name="version"/>
             <column name="create_date"/>
         </createIndex>

         <!-- Index modified_date + last_modified_by -->
         <createIndex indexName="annonce_idx_modified_idx_last_modified" tableName="annonce">
             <column name="modified_date"/>
             <column name="last_modified_by"/>
         </createIndex>

         <!-- Index created_by -->
         <createIndex indexName="annonce_idx_created_by" tableName="annonce">
             <column name="created_by"/>
         </createIndex>

         <createIndex indexName="annonce_idx_titre" tableName="annonce">
	<column name="titre"/>
</createIndex>
<createIndex indexName="annonce_idx_actif" tableName="annonce">
	<column name="actif"/>
</createIndex>
<createIndex indexName="annonce_idx_prix" tableName="annonce">
	<column name="prix"/>
</createIndex>
<!--COLUMNS_INDEX-->
     </changeSet>

     <changeSet id="add-col-uid-on-annonce" author="system">
        <validCheckSum>ANY</validCheckSum>
         <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="annonce" columnName="UID"/>
            </not>
        </preConditions>
        <addColumn tableName="annonce">
            <column name="UID" type="VARCHAR(36)"/>
        </addColumn>
     </changeSet>

    <changeSet id="add-col-titre-on-annonce" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="annonce" columnName="titre"/></not>
        </preConditions>
        <addColumn tableName="annonce">
                    <column name="titre" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-idx-titre-on-annonce" author="system" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="annonce" columnName="titre"/>
        </preConditions>
        <sql dbms="postgresql">CREATE INDEX IF NOT EXISTS annonce_idx_titre ON annonce ("titre")</sql>
        <sql dbms="h2">CREATE INDEX IF NOT EXISTS annonce_idx_titre ON annonce (titre)</sql>
    </changeSet>
    <changeSet id="add-col-description-on-annonce" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="annonce" columnName="description"/></not>
        </preConditions>
        <addColumn tableName="annonce">
                    <column name="description" type="TEXT"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-col-actif-on-annonce" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="annonce" columnName="actif"/></not>
        </preConditions>
        <addColumn tableName="annonce">
                    <column name="actif" type="INTEGER"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-idx-actif-on-annonce" author="system" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="annonce" columnName="actif"/>
        </preConditions>
        <sql dbms="postgresql">CREATE INDEX IF NOT EXISTS annonce_idx_actif ON annonce ("actif")</sql>
        <sql dbms="h2">CREATE INDEX IF NOT EXISTS annonce_idx_actif ON annonce (actif)</sql>
    </changeSet>
    <changeSet id="add-col-prix-on-annonce" author="system">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="annonce" columnName="prix"/></not>
        </preConditions>
        <addColumn tableName="annonce">
                    <column name="prix" type="NUMERIC"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-idx-prix-on-annonce" author="system" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="annonce" columnName="prix"/>
        </preConditions>
        <sql dbms="postgresql">CREATE INDEX IF NOT EXISTS annonce_idx_prix ON annonce ("prix")</sql>
        <sql dbms="h2">CREATE INDEX IF NOT EXISTS annonce_idx_prix ON annonce (prix)</sql>
    </changeSet>

    <changeSet id="5" author="Annonce-schema-type-managed">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="annonce">
            <column name="type_oid" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint  baseColumnNames="type_oid"
                                  baseTableName="annonce"
                                  constraintName="Annonce_type_managed_fk_oid_constraint"
                                  referencedColumnNames="oid"
                                  referencedTableName="T_SOFTTYPE"/>
    </changeSet>
    <!-- Free lifecycle (katappult-core >= 4.26): no XML lifecycle graph anymore. The states
         (lifecycle_config) and the indicative transitions attached to the business type are
         generated in the annonce-type.xml changelog. -->
    <changeSet id="3" author="Annonce-schema-lfmanaged">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="annonce">
            <column name="lifecycle_oid" type="BIGINT"/>
            <column name="lifecycle_state" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

    <changeSet id="6" author="Annonce-schema-thumbed">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="annonce">
            <column name="thumbnail_oid" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint  baseColumnNames="thumbnail_oid"
                                  baseTableName="annonce"
                                  constraintName="Annonce_thumbed_thumbnail_fk_oid_constraint"
                                  referencedColumnNames="oid"
                                  referencedTableName="T_THUMBNAIL_HOLDER"/>
    </changeSet>
</databaseChangeLog>

