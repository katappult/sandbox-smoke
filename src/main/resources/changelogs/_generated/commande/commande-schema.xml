<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

   <changeSet id="1" author="Commande-schema-sequence">
        <validCheckSum>ANY</validCheckSum>
        <preConditions>
             <not>
                 <sequenceExists sequenceName="commande_oid_seq"/>
             </not>
          </preConditions>
          <createSequence sequenceName="commande_oid_seq" incrementBy="3" startValue="11123"/>
    </changeSet>

	<changeSet id="1" author="Commande-schema">
        <validCheckSum>ANY</validCheckSum>
        <createTable tableName="commande">
            <column name="OID" type="integer" defaultValueComputed="nextval('commande_oid_seq')">
                <constraints primaryKey="true" unique="true"/>
            </column>

            <column name="CREATE_DATE" type="TIMESTAMP"  defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="CREATED_BY" type="varchar(255)" defaultValue="system">
                <constraints nullable="false" />
            </column>
            <column name="LAST_MODIFIED_BY" type="varchar(255)" defaultValue="system">
                <constraints nullable="false" />
            </column>
            <column name="MODIFIED_DATE" type="TIMESTAMP"  defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="VERSION" type="BIGINT" defaultValue="1">
                <constraints nullable="false" />
            </column>
            <column name="container_oid" type="BIGINT" defaultValue="1">
                <constraints nullable="false" />
            </column>

                    <column name="montant_total" type="NUMERIC"/>
        <column name="date_commande" type="TIMESTAMP"/>
<!--COLUMNS-->
        </createTable>
    </changeSet>

    <changeSet id="drop-index" author="Commande-schema-master">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <indexExists
                indexName="commande_primary_index"
                tableName="commande"/>
        </preConditions>

        <dropIndex indexName="commande_primary_index" tableName="commande"/>
    </changeSet>

    <changeSet id="create-optimized-indexes-commande" author="system">
        <validCheckSum>ANY</validCheckSum>
        <createIndex indexName="commande_idx_version" tableName="commande">
            <column name="version"/>
        </createIndex>
        <createIndex indexName="commande_idx_create" tableName="commande">
            <column name="create_date"/>
        </createIndex>
        <createIndex indexName="commande_idx_modified" tableName="commande">
            <column name="modified_date"/>
        </createIndex>

         <!-- Index version + create_date -->
         <createIndex indexName="commande_idx_version_create" tableName="commande">
             <column name="version"/>
             <column name="create_date"/>
         </createIndex>

         <!-- Index modified_date + last_modified_by -->
         <createIndex indexName="commande_idx_modified_idx_last_modified" tableName="commande">
             <column name="modified_date"/>
             <column name="last_modified_by"/>
         </createIndex>

         <!-- Index created_by -->
         <createIndex indexName="commande_idx_created_by" tableName="commande">
             <column name="created_by"/>
         </createIndex>

         <createIndex indexName="commande_idx_date_commande" tableName="commande">
	<column name="date_commande"/>
</createIndex>
<createIndex indexName="commande_idx_montant_total" tableName="commande">
	<column name="montant_total"/>
</createIndex>
<!--COLUMNS_INDEX-->
     </changeSet>

     <changeSet id="add-col-uid-on-commande" author="system">
        <validCheckSum>ANY</validCheckSum>
         <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="commande" columnName="UID"/>
            </not>
        </preConditions>
        <addColumn tableName="commande">
            <column name="UID" type="VARCHAR(36)"/>
        </addColumn>
     </changeSet>


    <changeSet id="5" author="Commande-schema-type-managed">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="commande">
            <column name="type_oid" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint  baseColumnNames="type_oid"
                                  baseTableName="commande"
                                  constraintName="Commande_type_managed_fk_oid_constraint"
                                  referencedColumnNames="oid"
                                  referencedTableName="T_SOFTTYPE"/>
    </changeSet>

    <changeSet id="2" author="Commande-schema-lfmanaged">
        <validCheckSum>ANY</validCheckSum>
        <insert tableName="T_LIFECYCLEMASTER">
            <column name="name" value="Commande lifecycle"/>
            <column name="number" value="COMMANDE_0001"/>
            <column name="description" value="Commande lifecycle description"/>
            <column name="container_oid" value="1"/>
        </insert>
        <insert tableName="T_LIFECYCLE">
            <column name="is_latest_iteration" value="1"/>
            <column name="iteration_number" value="1"/>
            <column name="is_working_copy" value="0"/>
            <column name="container_oid" value="1"/>
            <column name="master_oid" valueComputed="(select oid from T_LIFECYCLEMASTER where name='Commande lifecycle')"/>
            <column name="initial_state" value="NEW"/>
            <column name="terminal_state" value="CLOSED"/>
        </insert>

        <insert tableName="T_CONTENTITEM">
            <column name="content_size" value="10"/>
            <column name="md5" value="1"/>
            <column name="rating" valueNumeric="1"/>
            <column name="download_count" valueNumeric="1"/>
            <column name="name" value="COMMANDE_LIFECYCLE"/>
            <column name="dtype" value="PRIM"/>
            <column name="container_oid" value="1"/>
        </insert>
        <insert tableName="T_CONTENTLOCATION">
            <column name="content_type" value="BLOB"/>
            <column name="name" value="COMMANDE_LIFECYCLE"/>
            <column name="item_oid" valueComputed="(select oid from T_CONTENTITEM where name='COMMANDE_LIFECYCLE')"/>
        </insert>
        <update tableName="T_CONTENTLOCATION">
            <column name="content_blob" valueBlobFile="datas/commande-lifecycle.xml"/>
            <where>name='COMMANDE_LIFECYCLE'</where>
        </update>
        <update tableName="T_LIFECYCLE">
            <column name="primary_content_oid" valueComputed="(select oid from T_CONTENTITEM where name='COMMANDE_LIFECYCLE')"/>
            <where>master_oid=(select oid from t_lifecyclemaster where name='Commande lifecycle')</where>
        </update>

        <insert tableName="T_LIFECYCLETRANSITION">
            <column name="from_state" value="NEW"/>
            <column name="to_state" value="ACCEPTED"/>
            <column name="action" value="SET_STATE"/>
            <column name="lifecycle_oid" valueComputed="(select l.oid from t_lifecyclemaster m, t_lifecycle l where m.oid=l.master_oid and m.name ='Commande lifecycle')"/>
        </insert>
        <insert tableName="T_LIFECYCLETRANSITION">
            <column name="from_state" value="NEW"/>
            <column name="to_state" value="REFUSED"/>
            <column name="action" value="SET_STATE"/>
            <column name="lifecycle_oid" valueComputed="(select l.oid from t_lifecyclemaster m, t_lifecycle l where m.oid=l.master_oid and m.name ='Commande lifecycle')"/>
        </insert>

        <insert tableName="T_LIFECYCLETRANSITION">
            <column name="from_state" value="NEW"/>
            <column name="to_state" value="ACCEPTED"/>
            <column name="action" value="ADMINSET_STATE"/>
            <column name="lifecycle_oid" valueComputed="(select l.oid from t_lifecyclemaster m, t_lifecycle l where m.oid=l.master_oid and m.name ='Commande lifecycle')"/>
        </insert>
        <insert tableName="T_LIFECYCLETRANSITION">
            <column name="from_state" value="ACCEPTED"/>
            <column name="to_state" value="REFUSED"/>
            <column name="action" value="SET_STATE"/>
            <column name="lifecycle_oid" valueComputed="(select l.oid from t_lifecyclemaster m, t_lifecycle l where m.oid=l.master_oid and m.name ='Commande lifecycle')"/>
        </insert>
        <insert tableName="T_LIFECYCLETRANSITION">
            <column name="from_state" value="REFUSED"/>
            <column name="to_state" value="ACCEPTED"/>
            <column name="action" value="ADMINSET_STATE"/>
            <column name="lifecycle_oid" valueComputed="(select l.oid from t_lifecyclemaster m, t_lifecycle l where m.oid=l.master_oid and m.name ='Commande lifecycle')"/>
        </insert>
        <insert tableName="T_LIFECYCLETRANSITION">
            <column name="from_state" value="ACCEPTED"/>
            <column name="to_state" value="NEW"/>
            <column name="action" value="ADMINSET_STATE"/>
            <column name="lifecycle_oid" valueComputed="(select l.oid from t_lifecyclemaster m, t_lifecycle l where m.oid=l.master_oid and m.name ='Commande lifecycle')"/>
        </insert>
        <insert tableName="T_LIFECYCLETRANSITION">
            <column name="from_state" value="ACCEPTED"/>
            <column name="to_state" value="CLOSED"/>
            <column name="action" value="ADMINSET_STATE"/>
            <column name="lifecycle_oid" valueComputed="(select l.oid from t_lifecyclemaster m, t_lifecycle l where m.oid=l.master_oid and m.name ='Commande lifecycle')"/>
        </insert>
    </changeSet>

    <changeSet id="3" author="Commande-schema-lfmanaged">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="commande">
            <column name="lifecycle_oid" type="BIGINT"/>
            <column name="lifecycle_state" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

    <changeSet id="6" author="Commande-schema-numberable">
        <validCheckSum>ANY</validCheckSum>
        <addColumn tableName="commande">
            <column name="number" type="varchar(20)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>

